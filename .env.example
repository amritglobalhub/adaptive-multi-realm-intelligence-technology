# AMRIT AI Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite:///./amrit.db
# For PostgreSQL: postgresql://user:password@localhost/amrit_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption
ENCRYPTION_KEY=your-encryption-key-change-this

# OpenAI (for text generation)
OPENAI_API_KEY=your-openai-api-key

# Master/Owner Configuration
MASTER_NAME=Amrit Gupta
MASTER_BIRTH_DATE=06/11/2000
MASTER_BIRTH_TIME=18:00
MASTER_BIRTH_PLACE=New Delhi

# Voice Settings
VOICE_SAMPLE_RATE=16000
VOICE_MIN_DURATION=1.0
VOICE_MAX_DURATION=300.0

# Image Generation
STABLE_DIFFUSION_MODEL=stabilityai/stable-diffusion-2-1

# Security
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT=3600
IP_WHITELIST_ENABLED=False

# Analytics
ENABLE_TRACKING=True
ENABLE_ENVIRONMENTAL_DATA=True

# Link Generation
LINK_EXPIRY_DAYS=7
BASE_URL=http://localhost:8000
